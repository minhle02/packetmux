{
  "scenarios": [
    {"name": "connect-and-exchange-data", "requirement": "FR-CLI-1", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "expect_state", "state": "connected"},
      {"op": "open", "kind": "echo", "as": "s"},
      {"op": "write", "stream": "s", "data": "aabb"},
      {"op": "expect_read", "stream": "s", "data": "aabb"}
    ]},
    {"name": "session-id-is-generated", "requirement": "FR-CLI-1a", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "connect", "as": "other"},
      {"op": "expect_session_ids_differ", "a": "client", "b": "other"},
      {"op": "expect_dial_ids_match", "client": "client"}
    ]},
    {"name": "connect-retries-a-failed-dial", "requirement": "FR-CLI-1", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "dial_fails", "count": 2},
      {"op": "connect"},
      {"op": "expect_state", "state": "connected"},
      {"op": "open", "kind": "echo", "as": "s"},
      {"op": "write", "stream": "s", "data": "aabb"},
      {"op": "expect_read", "stream": "s", "data": "aabb"}
    ]},
    {"name": "connect-gives-up-after-the-timeout", "requirement": "FR-CLI-1", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 30}, "steps": [
      {"op": "dial_hangs"},
      {"op": "connect", "expect_error": "NoConnection"}
    ]},
    {"name": "connect-stops-when-dial-gives-up", "requirement": "FR-CLI-3", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "dial_gives_up"},
      {"op": "connect", "expect_error": "GiveUp"}
    ]},
    {"name": "reconnects-after-a-lost-connection", "requirement": "FR-CLI-2", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "open", "kind": "echo", "as": "s"},
      {"op": "write", "stream": "s", "data": "aabb"},
      {"op": "expect_read", "stream": "s", "data": "aabb"},
      {"op": "break"},
      {"op": "expect_dials", "min": 2},
      {"op": "expect_state", "state": "connected"},
      {"op": "open", "kind": "echo", "as": "again"},
      {"op": "write", "stream": "again", "data": "cc"},
      {"op": "expect_read", "stream": "again", "data": "cc"},
      {"op": "expect_sessions", "count": 1}
    ]},
    {"name": "streams-end-when-the-connection-does", "requirement": "FR-CLI-4", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "open", "kind": "echo", "as": "s"},
      {"op": "break"},
      {"op": "expect_stream_closed", "stream": "s", "code": "TRANSPORT_LOST"},
      {"op": "expect_error", "stream": "s", "call": "read", "error": "StreamReset", "code": "TRANSPORT_LOST"}
    ]},
    {"name": "state-goes-through-reconnecting", "requirement": "FR-CLI-5", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "record_states"},
      {"op": "dial_hangs"},
      {"op": "break"},
      {"op": "expect_state", "state": "reconnecting"},
      {"op": "dial_works"},
      {"op": "expect_state", "state": "connected"},
      {"op": "expect_states", "states": ["reconnecting", "connected"]}
    ]},
    {"name": "no-attempt-limit-after-connect", "requirement": "D15", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "dial_fails", "count": 25},
      {"op": "break"},
      {"op": "expect_dials", "min": 27},
      {"op": "expect_state", "state": "connected"}
    ]},
    {"name": "dial-can-give-up-while-reconnecting", "requirement": "FR-CLI-3", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "dial_gives_up"},
      {"op": "break"},
      {"op": "expect_closed", "error": "GiveUp"}
    ]},
    {"name": "open-waits-while-reconnecting", "requirement": "FR-CLI-4", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "dial_hangs"},
      {"op": "break"},
      {"op": "expect_state", "state": "reconnecting"},
      {"op": "open", "kind": "echo", "as": "s", "background": "pending"},
      {"op": "settle"},
      {"op": "dial_works"},
      {"op": "await", "task": "pending", "stream": "s"},
      {"op": "write", "stream": "s", "data": "aa"},
      {"op": "expect_read", "stream": "s", "data": "aa"}
    ]},
    {"name": "open-times-out-while-reconnecting", "requirement": "FR-CLI-4", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 30}, "steps": [
      {"op": "connect"},
      {"op": "dial_hangs"},
      {"op": "break"},
      {"op": "expect_state", "state": "reconnecting"},
      {"op": "open", "kind": "echo", "as": "s", "expect_error": "NoConnection"}
    ]},
    {"name": "goaway-stops-reconnecting", "requirement": "FR-CLI-3", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "dial_count"},
      {"op": "close_session", "code": "AUTH_REVOKED"},
      {"op": "expect_closed", "error": "SessionClosed", "code": "AUTH_REVOKED"},
      {"op": "settle"},
      {"op": "expect_no_new_dials"}
    ]},
    {"name": "resume-after-the-server-lost-the-session", "requirement": "FR-CLI-4a", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500, "grace_period_ms": 5}, "steps": [
      {"op": "connect"},
      {"op": "dial_hangs"},
      {"op": "break"},
      {"op": "expect_sessions", "count": 0},
      {"op": "dial_works"},
      {"op": "expect_closed", "error": "SessionNotFound", "code": "SESSION_NOT_FOUND"},
      {"op": "expect_sessions", "count": 0}
    ]},
    {"name": "a-new-connect-works-after-session-not-found", "requirement": "FR-CLI-4a", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500, "grace_period_ms": 5}, "steps": [
      {"op": "connect"},
      {"op": "dial_hangs"},
      {"op": "break"},
      {"op": "expect_sessions", "count": 0},
      {"op": "dial_works"},
      {"op": "expect_closed", "error": "SessionNotFound", "code": "SESSION_NOT_FOUND"},
      {"op": "connect", "as": "fresh"},
      {"op": "expect_session_ids_differ", "a": "client", "b": "fresh"},
      {"op": "open", "on": "fresh", "kind": "echo", "as": "s"},
      {"op": "write", "stream": "s", "data": "aa"},
      {"op": "expect_read", "stream": "s", "data": "aa"}
    ]},
    {"name": "close-ends-both-sides", "requirement": "FR-CLI-6", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "open", "kind": "echo", "as": "s"},
      {"op": "close"},
      {"op": "expect_state", "state": "closed"},
      {"op": "expect_closed"},
      {"op": "expect_sessions", "count": 0}
    ]},
    {"name": "close-is-idempotent", "requirement": "FR-CLI-6", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "close"},
      {"op": "close"},
      {"op": "expect_closed"}
    ]},
    {"name": "close-while-reconnecting", "requirement": "FR-CLI-6", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "dial_hangs"},
      {"op": "break"},
      {"op": "expect_state", "state": "reconnecting"},
      {"op": "close"},
      {"op": "expect_closed"}
    ]},
    {"name": "close-sends-its-code-to-the-peer", "requirement": "FR-CLI-6", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "record_server_close"},
      {"op": "close", "code": "AUTH_REVOKED"},
      {"op": "expect_sessions", "count": 0},
      {"op": "expect_server_close", "code": "AUTH_REVOKED"}
    ]},
    {"name": "open-after-close-fails", "requirement": "FR-CLI-6", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "connect"},
      {"op": "close"},
      {"op": "open", "kind": "echo", "as": "s", "expect_error": "SessionClosed"}
    ]},
    {"name": "a-transport-too-small-is-refused", "requirement": "FR-TP-4", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "small_transport", "max_message_size": 100},
      {"op": "connect", "expect_error": "GiveUp"}
    ]},
    {"name": "cancelling-connect-stops-dialing", "requirement": "FR-CLI-7", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "dial_fails", "count": 100000},
      {"op": "cancel_connect"},
      {"op": "dial_count"},
      {"op": "settle"},
      {"op": "expect_no_new_dials"}
    ]},
    {"name": "cancelling-connect-during-a-hung-dial-leaves-no-session", "requirement": "FR-CLI-7", "handlers": {"echo": "echo"}, "options": {"reconnect_backoff_ms": [1], "connect_timeout_ms": 500}, "steps": [
      {"op": "dial_hangs"},
      {"op": "cancel_connect"},
      {"op": "dial_works"},
      {"op": "settle"},
      {"op": "expect_sessions", "count": 0},
      {"op": "expect_no_session_closed"}
    ]}
  ]
}
