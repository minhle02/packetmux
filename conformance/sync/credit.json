{
  "scenarios": [
    {"name": "hello-announces-the-window", "requirement": "FR-FC-1", "role": "client", "config": {"receive_window": 70000}, "steps": [
      {"op": "attach"},
      {"op": "expect_frames", "frames": [{"type": "HELLO", "session_id": "session-1", "receive_window": 70000}]}
    ]},
    {"name": "a-sender-stops-at-the-window", "requirement": "FR-FC-2", "role": "client", "config": {"max_data_payload": 40}, "steps": [
      {"op": "attach"},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1", "receive_window": 100}},
      {"op": "drain"},
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "write", "stream": 1, "data": {"repeat": "ab", "count": 120}, "expect_accepted": 120},
      {"op": "expect_frames", "frames": [{"type": "OPEN", "stream_id": 1, "kind": "k"}, {"type": "DATA", "stream_id": 1}, {"type": "DATA", "stream_id": 1}]},
      {"op": "expect_streams", "streams": [{"stream_id": 1, "send_credit": 20}]},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "WINDOW", "stream_id": 1, "credit": 10}},
      {"op": "expect_frames", "frames": []},
      {"op": "rx", "frame": {"type": "WINDOW", "stream_id": 1, "credit": 10}},
      {"op": "expect_frames", "frames": [{"type": "DATA", "stream_id": 1}]},
      {"op": "expect_streams", "streams": [{"stream_id": 1, "send_credit": 0}]}
    ]},
    {"name": "credit-is-per-stream", "requirement": "FR-FC-3", "role": "client", "config": {"max_data_payload": 40}, "steps": [
      {"op": "attach"},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1", "receive_window": 80}},
      {"op": "drain"},
      {"op": "open", "kind": "a", "expect_id": 1},
      {"op": "open", "kind": "b", "expect_id": 3},
      {"op": "drain_frames"},
      {"op": "write", "stream": 1, "data": {"repeat": "ab", "count": 120}},
      {"op": "expect_frames", "frames": [{"type": "DATA", "stream_id": 1}, {"type": "DATA", "stream_id": 1}]},
      {"op": "write", "stream": 3, "data": {"repeat": "ab", "count": 40}},
      {"op": "expect_frames", "frames": [{"type": "DATA", "stream_id": 3}]}
    ]},
    {"name": "eof-needs-no-credit", "requirement": "FR-FC-4", "role": "client", "config": {"max_data_payload": 40}, "steps": [
      {"op": "attach"},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1", "receive_window": 80}},
      {"op": "drain"},
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "write", "stream": 1, "data": {"repeat": "ab", "count": 80}},
      {"op": "eof", "stream": 1},
      {"op": "expect_frames", "frames": [{"type": "DATA", "stream_id": 1}, {"type": "DATA", "stream_id": 1}, {"type": "EOF", "stream_id": 1}]}
    ]},
    {"name": "eof-stays-behind-parked-data", "requirement": "FR-FC-4", "role": "client", "config": {"max_data_payload": 40}, "steps": [
      {"op": "attach"},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1", "receive_window": 80}},
      {"op": "drain"},
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "write", "stream": 1, "data": {"repeat": "ab", "count": 120}},
      {"op": "eof", "stream": 1},
      {"op": "expect_frames", "frames": [{"type": "DATA", "stream_id": 1}, {"type": "DATA", "stream_id": 1}]},
      {"op": "rx", "frame": {"type": "WINDOW", "stream_id": 1, "credit": 40}},
      {"op": "expect_frames", "frames": [{"type": "DATA", "stream_id": 1}, {"type": "EOF", "stream_id": 1}]}
    ]},
    {"name": "queued-data-keeps-its-credit-after-a-local-close", "requirement": "FR-FC-5", "role": "client", "config": {"max_data_payload": 40}, "steps": [
      {"op": "attach"},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1", "receive_window": 80}},
      {"op": "drain"},
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "EOF", "stream_id": 1}},
      {"op": "drain"},
      {"op": "write", "stream": 1, "data": {"repeat": "ab", "count": 120}},
      {"op": "eof", "stream": 1},
      {"op": "drain_events"},
      {"op": "expect_streams", "streams": []},
      {"op": "expect_frames", "frames": [{"type": "DATA", "stream_id": 1}, {"type": "DATA", "stream_id": 1}]},
      {"op": "rx", "frame": {"type": "WINDOW", "stream_id": 1, "credit": 40}},
      {"op": "expect_frames", "frames": [{"type": "DATA", "stream_id": 1}, {"type": "EOF", "stream_id": 1}]}
    ]},
    {"name": "data-past-the-credit-ends-the-connection", "requirement": "FR-FC-6", "role": "client", "setup": "established", "config": {"receive_window": 100, "max_data_payload": 40}, "steps": [
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 21}}},
      {"op": "expect_state", "state": "DRAINING"},
      {"op": "drain"}
    ]},
    {"name": "data-up-to-the-credit-is-fine", "requirement": "FR-FC-6", "role": "client", "setup": "established", "config": {"receive_window": 100, "max_data_payload": 40}, "steps": [
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 20}}},
      {"op": "drain_events"},
      {"op": "expect_state", "state": "ESTABLISHED"}
    ]},
    {"name": "window-past-the-peer-window-ends-the-connection", "requirement": "FR-FC-7", "role": "client", "steps": [
      {"op": "attach"},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1", "receive_window": 100}},
      {"op": "drain"},
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "WINDOW", "stream_id": 1, "credit": 1}},
      {"op": "expect_state", "state": "DRAINING"},
      {"op": "drain"}
    ]},
    {"name": "a-grant-comes-at-half-a-window", "requirement": "FR-FC-8", "role": "client", "setup": "established", "config": {"receive_window": 100, "max_data_payload": 40}, "steps": [
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "consume", "stream": 1, "bytes": 49},
      {"op": "expect_frames", "frames": []},
      {"op": "consume", "stream": 1, "bytes": 1},
      {"op": "expect_frames", "frames": [{"type": "WINDOW", "stream_id": 1, "credit": 50}]},
      {"op": "consume", "stream": 1, "bytes": 30},
      {"op": "expect_frames", "frames": []}
    ]},
    {"name": "a-grant-gives-the-peer-room-again", "requirement": "FR-FC-8", "role": "client", "setup": "established", "config": {"receive_window": 100, "max_data_payload": 40}, "steps": [
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 20}}},
      {"op": "drain_events"},
      {"op": "consume", "stream": 1, "bytes": 50},
      {"op": "drain_frames"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 10}}},
      {"op": "drain_events"},
      {"op": "expect_state", "state": "ESTABLISHED"}
    ]},
    {"name": "no-grant-after-the-peer-eof", "requirement": "FR-FC-8", "role": "client", "setup": "established", "config": {"receive_window": 100, "max_data_payload": 40}, "steps": [
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 40}}},
      {"op": "drain_events"},
      {"op": "rx", "frame": {"type": "EOF", "stream_id": 1}},
      {"op": "drain_events"},
      {"op": "consume", "stream": 1, "bytes": 80},
      {"op": "expect_frames", "frames": []}
    ]},
    {"name": "consuming-a-closed-stream-is-fine", "requirement": "FR-FC-9", "role": "client", "setup": "established", "steps": [
      {"op": "consume", "stream": 1, "bytes": 10},
      {"op": "expect_state", "state": "ESTABLISHED"}
    ]},
    {"name": "consuming-more-than-was-delivered-is-refused", "requirement": "FR-FC-9", "role": "client", "setup": "established", "config": {"receive_window": 100, "max_data_payload": 40}, "steps": [
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 10}}},
      {"op": "drain_events"},
      {"op": "consume", "stream": 1, "bytes": 11, "expect_status": "INVALID_ARGUMENT"},
      {"op": "consume", "stream": 1, "bytes": 10}
    ]},
    {"name": "window-on-an-unknown-stream-is-ignored", "requirement": "FR-FC-10", "role": "client", "setup": "established", "steps": [
      {"op": "rx", "frame": {"type": "WINDOW", "stream_id": 99, "credit": 1}},
      {"op": "expect_state", "state": "ESTABLISHED"}
    ]},
    {"name": "a-small-peer-window-caps-the-frame", "requirement": "FR-FC-11", "role": "client", "steps": [
      {"op": "attach"},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1", "receive_window": 10}},
      {"op": "drain"},
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "write", "stream": 1, "data": {"repeat": "ab", "count": 10}},
      {"op": "expect_frames", "frames": [{"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 5}}, {"type": "DATA", "stream_id": 1, "data": {"repeat": "ab", "count": 5}}]}
    ]},
    {"name": "a-write-waits-for-the-peer-hello", "requirement": "FR-FC-12", "role": "client", "steps": [
      {"op": "attach"},
      {"op": "drain"},
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "write", "stream": 1, "data": {"repeat": "ab", "count": 4}, "expect_accepted": 0},
      {"op": "expect_frames", "frames": [{"type": "OPEN", "stream_id": 1, "kind": "k"}]},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1"}},
      {"op": "expect_events", "events": [{"type": "CONNECTED", "peer_session_id": "peer-1"}, {"type": "WRITABLE", "stream_id": 1}]},
      {"op": "write", "stream": 1, "data": {"repeat": "ab", "count": 4}, "expect_accepted": 4},
      {"op": "expect_frames", "frames": [{"type": "DATA", "stream_id": 1}]}
    ]},
    {"name": "each-connection-has-its-own-peer-window", "requirement": "FR-FC-13", "role": "client", "steps": [
      {"op": "attach"},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1", "receive_window": 100}},
      {"op": "drain"},
      {"op": "lost"},
      {"op": "drain"},
      {"op": "attach"},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1", "receive_window": 6}},
      {"op": "drain"},
      {"op": "open", "kind": "k"},
      {"op": "drain_frames"},
      {"op": "expect_streams", "streams": [{"stream_id": 1, "send_credit": 6}]}
    ]},
    {"name": "a-close-does-not-wait-for-credit", "requirement": "FR-FC-14", "role": "client", "config": {"max_data_payload": 40}, "steps": [
      {"op": "attach"},
      {"op": "drain"},
      {"op": "rx", "frame": {"type": "HELLO", "session_id": "peer-1", "receive_window": 80}},
      {"op": "drain"},
      {"op": "open", "kind": "k", "expect_id": 1},
      {"op": "rx", "frame": {"type": "OPEN_OK", "stream_id": 1}},
      {"op": "drain"},
      {"op": "write", "stream": 1, "data": {"repeat": "ab", "count": 120}},
      {"op": "drain_frames"},
      {"op": "close", "code": "OK"},
      {"op": "expect_frames", "frames": [{"type": "GOAWAY", "code": "OK"}]},
      {"op": "drain_events"},
      {"op": "expect_state", "state": "CLOSED"}
    ]},
    {"name": "a-small-receive-window-is-refused", "requirement": "FR-FC-15", "role": "client", "config": {"receive_window": 31999}, "steps": [
      {"op": "attach", "expect_status": "INVALID_ARGUMENT"},
      {"op": "expect_state", "state": "DISCONNECTED"}
    ]}
  ]
